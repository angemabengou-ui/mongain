// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  splitRequestsSent     SplitRequest[] @relation("SplitRequester")
  splitRequestsReceived SplitRequest[] @relation("SplitTarget")
  loyaltyPoints         Float          @default(0)
  id                    String         @id @default(uuid())
  username              String?        @unique // Secondary auth identifier (Anti-SIM recycle)
  email                 String?        @unique // Optional tertiary auth and recovery
  accountNumber         String?        @unique // MONG-ID — identifiant de compte alternatif au téléphone (voir wallet.ts lookups, auth.ts register, migrate-mong-id.ts)
  name                  String
  phone                 String         @unique
  pin                   String // hashed pin code
  failedPinAttempts     Int            @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  role                  String         @default("USER") // USER, AGENT, ADMIN, MERCHANT
  isActive              Boolean        @default(true) // Legacy fallback
  accountStatus         String         @default("ACTIVE") // ACTIVE, SUSPENDED, FROZEN, CLOSED
  freezeReason          String?
  frozenUntil           DateTime?

  jwtVersion Int     @default(0) // Invalidates sessions when logged in elsewhere
  pushToken  String?

  // Refresh token (session longue durée) : un seul actif à la fois par utilisateur,
  // cohérent avec le single-device enforcement déjà en place via jwtVersion — une
  // nouvelle connexion écrase l'ancien refresh token. On stocke un hash SHA-256 (pas
  // le token en clair) pour qu'une fuite de la base ne permette pas de rejouer une
  // session ; rotation à chaque appel /auth/refresh (voir routes/auth.ts).
  refreshTokenHash      String?   @unique
  refreshTokenExpiresAt DateTime?

  // Rattachement agence (pertinent pour role=AGENT) — référence libre, cohérente avec
  // Transaction.branchId/tellerId (bounded context Ledger volontairement découplé, voir
  // Reclamation.branchId plus bas). Les opérations effectuées par un agent rattaché sont
  // désormais comptabilisées dans les rapports de son agence (voir wallet.ts /transfer et
  // /client-initiated-withdraw).
  branchId String?

  // Nouveaux Champs KYC
  kycLevel        Int     @default(0) // 0: Standard, 1: Vérifié, 2: Premium
  kycStatus       String  @default("UNVERIFIED") // UNVERIFIED, PENDING, APPROVED, REJECTED
  kycRejectReason String? // Motif du dernier rejet, saisi par le compliance officer
  idCardFront     String?
  idCardBack      String?
  selfie          String?

  // Emplacement réservé pour un futur prestataire externe de vérification d'identité /
  // détection de fraude (ex : Smile Identity, Onfido, Sumsub — courants en Afrique). Aucun
  // prestataire n'est intégré à ce jour : voir services/kycVendorCheck.ts, dont
  // l'implémentation actuelle est un no-op tant qu'aucune clé d'API n'est configurée
  // (kycVendorStatus reste alors "NOT_CONFIGURED", sans aucun appel réseau ni coût). Ces
  // champs ne conditionnent jamais la décision KYC elle-même, qui reste humaine
  // (perm_customer_kyc_validate) — ils ne font qu'afficher un signal complémentaire une fois
  // un vrai prestataire branché.
  kycVendorProvider  String?
  kycVendorStatus    String? // null (jamais vérifié), NOT_CONFIGURED, PASS, FAIL, REVIEW
  kycVendorCheckedAt DateTime?

  // Nouveaux Champs: Limites Personnalisées (PROMPT 03)
  customDailyLimit     Float?
  customMonthlyLimit   Float?
  customPerTxLimit     Float?
  customLimitExpiresAt DateTime?

  wallet                 Wallet?
  // Solde de commission d'un marchand (role=MERCHANT), séparé du wallet principal
  // (ventes/paiements) — même convention qu'une Branch/CentralTreasury : un Wallet
  // orphelin (userId null) référencé par une colonne @unique dédiée, pas un second
  // Wallet.userId (contrainte @unique sur ce champ, un seul par utilisateur).
  commissionWalletId     String?                 @unique
  commissionWallet       Wallet?                 @relation("MerchantCommissionWallet", fields: [commissionWalletId], references: [id])
  merchantPayoutRequests MerchantPayoutRequest[] @relation("MerchantPayoutRequests")
  reclamations           Reclamation[]
  notifications          Notification[]
  riskFlags              RiskFlag[] // ( PROMPT 08 CRM )
  fraudCases             FraudCase[] // ( PROMPT 09 )
  refundRequests         RefundRequest[] // ( PROMPT 09 )
  tontineParticipations  TontineParticipant[]
  createdTontines        TontineGroup[]          @relation("GroupCreator")
  apiIntegrations        ApiIntegration[]        @relation("MerchantAPI")

  adminOfVaults              Vault[]            @relation("AdminVault")
  vaultMemberships           VaultMember[]      @relation("VaultMembership")
  requestedVaultTransactions VaultTransaction[] @relation("RequestedVaultTransactions")
  approvedVaultTransactions  VaultApproval[]    @relation("ApprovedVaultTransactions")
  vaultVouchers              VaultVoucher[]     @relation("VaultVouchers")
  virtualCards               VirtualCard[]
  cryptoWallets              CryptoWallet[]
  loans                      Loan[]
  invoices                   Invoice[]          @relation("MerchantInvoices")
  payoutBulks                PayoutBulk[]       @relation("MerchantPayoutBulks")

  // V16 Relations
  marketListings MarketListing[]     @relation("UserListings")
  buyerEscrows   EscrowTransaction[] @relation("BuyerEscrows")
  sellerEscrows  EscrowTransaction[] @relation("SellerEscrows")
  stakingVaults  StakingVault[]      @relation("UserStaking")
  apiKeys        ApiKey[]            @relation("MerchantApiKeys")
}

model Reclamation {
  id          String @id @default(uuid())
  title       String
  description String
  status      String @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING_CUSTOMER, WAITING_INTERNAL, REOPENED, RESOLVED, CLOSED, ESCALATED
  priority    String @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  category    String @default("OTHER") // ACCOUNT, KYC, TRANSACTION, CASH_IN, CASH_OUT, MERCHANT, AGENCY, FRAUD, REFUND, TECHNICAL, LIMIT, OTHER

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactionId String? // Loose reference — Ledger bounded context is sacred
  branchId      String?
  tellerId      String?
  staffId       String? // Caissier ou agent impliqué

  assigneeId String?
  assignee   Staff?  @relation("ReclamationAssignee", fields: [assigneeId], references: [id])

  // SLA
  slaDeadline DateTime?
  slaBreached Boolean   @default(false)

  // Escalade
  escalatedTo String? // COMPLIANCE, RISK, FINANCE, OPERATIONS
  escalatedAt DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes          ReclamationNote[]
  refundRequests RefundRequest[]
}

model ReclamationNote {
  id            String      @id @default(uuid())
  reclamationId String
  reclamation   Reclamation @relation(fields: [reclamationId], references: [id], onDelete: Cascade)

  authorId   String // ID of Staff
  authorName String

  content    String
  isInternal Boolean @default(true) // Si false, visible par le client

  createdAt DateTime @default(now())
}

model Wallet {
  id                  String   @id @default(uuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  balance             Float    @default(0.0)
  currency            String   @default("FCFA")
  dailySpent          Float    @default(0.0) // Dépense journalière (atomique, réinitialisé chaque jour)
  dailySpentResetAt   DateTime @default(now()) // Date dernière remise à zéro
  monthlySpent        Float    @default(0.0) // Dépense mensuelle
  monthlySpentResetAt DateTime @default(now()) // Remise à zéro mensuelle
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations inverses pour les transactions
  sentTransactions     Transaction[]    @relation("SenderWallet")
  receivedTransactions Transaction[]    @relation("ReceiverWallet")
  branch               Branch?
  centralTreasury      CentralTreasury?
  systemAccount        SystemAccount?
  merchantCommissionOf User?            @relation("MerchantCommissionWallet")
  virtualCards         VirtualCard[]    @relation("FundingWalletVirtualCards")
}

// Solde de commission d'un marchand — séparé du Wallet principal (ventes/paiements).
// Alimenté uniquement par wallet.ts (/client-initiated-withdraw, part `merchantReward`
// d'un retrait client chez ce marchand). Pas directement utilisable par les flux
// génériques de retrait/transfert : pour en disposer, le marchand passe par
// MerchantPayoutRequest (sourceAccount=COMMISSION), qui le consolide dans son Wallet
// principal une fois traité par le staff — voir admin.merchants.ts.
model MerchantPayoutRequest {
  id         String @id @default(uuid())
  merchantId String
  merchant   User   @relation("MerchantPayoutRequests", fields: [merchantId], references: [id])

  sourceAccount String // SALES (Wallet principal), COMMISSION (commissionWallet)
  amount        Float
  note          String? // motif optionnel du marchand

  status          String  @default("PENDING") // PENDING, EXECUTED, REJECTED
  rejectionReason String?

  processedById String?
  processedBy   Staff?  @relation("MerchantPayoutProcessor", fields: [processedById], references: [id])

  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@index([merchantId])
}

// Trésorerie Centrale — séparée du Siège (Branch isHQ=true) : avant, le wallet du
// Siège servait À LA FOIS de Réserve Centrale électronique (source de tout Mint et
// de toute Allocation vers les agences) ET de solde d'agence opérationnelle si des
// caissiers travaillaient physiquement au Siège — impossible à distinguer dans le
// rapprochement comptable, et un Super Admin rattaché au Siège voyait la masse
// monétaire globale affichée comme "sa" liquidité d'agence. Table volontairement
// minimale (singleton en pratique, un seul enregistrement) : la logique de bascule
// depuis l'ancien wallet Siège vit dans getCentralTreasury() (services/treasury.ts).
model CentralTreasury {
  id        String   @id @default(uuid())
  name      String   @default("Trésorerie Centrale Mongain")
  walletId  String   @unique
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  createdAt DateTime @default(now())
}

// Comptes techniques internes (contreparties de double-écriture) — Corporate (revenus de
// frais), Passerelle Externe (agrégateur Mobile Money/carte), Coffre Tontine, Services
// Partenaires (SEEG/CANAL/Télécom). Remplace l'ancien bricolage où chacun de ces comptes
// était une ligne User{role:"ADMIN"} recréée indépendamment (avec PIN inutile, parfois même
// en clair) à 8 endroits différents du code. Même forme que CentralTreasury ci-dessus
// (une seule table dédiée, un wallet propre par ligne via walletId) — CentralTreasury reste
// séparée volontairement : c'est un singleton avec sa propre logique de bascule historique
// (voir getCentralTreasury()), pas un compte technique de plus.
model SystemAccount {
  id        String   @id @default(uuid())
  kind      String   @unique // CORPORATE, EXTERNAL_GATEWAY, TONTINE_VAULT, SERVICE_PARTNER_SEEG, SERVICE_PARTNER_CANAL, SERVICE_PARTNER_TELECOM
  name      String
  walletId  String   @unique
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  amount    Float
  fee       Float    @default(0.0)
  status    String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  type      String   @default("TRANSFER") // TRANSFER, CASH_IN, CASH_OUT, REFUND, ALLOCATION
  reference String   @unique @default(cuid())
  createdAt DateTime @default(now())

  // Idempotency — prevents double-click / retry duplicates
  idempotencyKey String? @unique

  // Agency rapprochement
  branchId String?
  tellerId String?

  // Relations
  senderWalletId   String?
  receiverWalletId String

  senderWallet   Wallet? @relation("SenderWallet", fields: [senderWalletId], references: [id])
  receiverWallet Wallet  @relation("ReceiverWallet", fields: [receiverWalletId], references: [id])

  // Performance Indexes for Scale
  @@index([senderWalletId])
  @@index([receiverWalletId])
  @@index([createdAt])
  @@index([branchId])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(uuid())
  // Référence libre (pas de FK) : l'acteur peut être un User (rôle ADMIN historique) OU un
  // Staff (portail corporate) — deux tables distinctes. Un FK vers une seule des deux faisait
  // planter (violation de contrainte) chaque écriture émise par un compte Staff, c'est-à-dire
  // la quasi-totalité des actions du portail admin-web depuis le passage au modèle Staff/Corp.
  adminId   String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([adminId])
}

model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  // Isole les codes par intention : un code émis pour "réinitialiser le PIN" ne doit
  // jamais pouvoir être consommé par le flux "vérifier la connexion" (faille corrigée —
  // auparavant un seul code partagé par téléphone permettait de contourner le PIN via
  // /request-reset-otp + /verify-login-otp).
  purpose   String   @default("LOGIN") // REGISTER, LOGIN, RESET_PIN
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, purpose])
}

model SystemSettings {
  id             Int   @id @default(autoincrement())
  taxP2P         Float @default(0.01) // 1.0% par défaut
  taxCashIn      Float @default(0.015) // 1.5% - Distinct par nature du Cash-Out
  taxWithdraw    Float @default(0.013) // 1.3% par défaut
  rewardMerchant Float @default(0.003) // 0.3% par défaut

  // Limites journalières configurables (V4)
  dailyLimitTier0 Float @default(50000.0) // Plafond en FCFA par jour pour non-vérifiés
  dailyLimitTier1 Float @default(2000000.0) // Plafond en FCFA par jour pour vérifiés

  // Règles spécifiques Agences (V6)
  agencyWithdrawThreshold Float @default(500000.0) // Montant au-delà duquel le retrait agence est taxé
  agencyTaxWithdraw       Float @default(0.01) // Taxe de 1% sur la part excédentaire ou globale

  // Opérations & Intégrations Partenaires (V6)
  airtelEnabled  Boolean @default(true)
  moovEnabled    Boolean @default(true)
  seegEnabled    Boolean @default(true)
  tontineEnabled Boolean @default(true)

  airtelFee Float @default(0.015) // Frais opérateur Airtel
  moovFee   Float @default(0.010) // Frais opérateur Moov

  airtelApiKey String?
  moovApiKey   String?

  // PVit (agrégateur de paiement Mobile Money/carte, mypvit.pro) — dépôt Mobile Money réel.
  // Gérable depuis l'admin-web (Paramètres > Passerelles de Paiement) plutôt que par variable
  // d'environnement Render, pour que l'équipe puisse reconfigurer sans accès au dashboard Render.
  pvitSecretKey                    String?
  pvitCodeUrlPayment               String?
  pvitMerchantOperationAccountCode String?
  pvitCallbackUrlCode              String?
  pvitWebhookSecret                String?

  // Général
  platformName String @default("Mongain")
  currency     String @default("FCFA")
  timezone     String @default("Africa/Libreville")
  supportEmail String @default("support@mongain.com")
  supportPhone String @default("+2410000000")

  // Limites KYC Étendues
  dailyLimitTier2   Float @default(5000000.0)
  monthlyLimitTier0 Float @default(1000000.0)
  monthlyLimitTier1 Float @default(10000000.0)
  monthlyLimitTier2 Float @default(50000000.0)
  perTxLimitTier0   Float @default(50000.0)
  perTxLimitTier1   Float @default(500000.0)
  perTxLimitTier2   Float @default(2000000.0)

  // SLA (heures) — configurables depuis les Paramètres
  slaLowHours      Int @default(72)
  slaNormalHours   Int @default(48)
  slaHighHours     Int @default(24)
  slaCriticalHours Int @default(4)

  // Refund Maker/Checker seuil
  refundMakerCheckerThreshold Float @default(100000)

  // Maintenance & Sécurité
  globalMaintenance Boolean @default(false)
  circuitBreaker    Boolean @default(false)

  // Webhooks
  webhookUrl    String?
  webhookActive Boolean @default(false)
  webhookRetry  Int     @default(3)

  // Anti-Fraud & Cash Operations (V6)
  antiFractioningWindowHours Int    @default(24) // Fenêtre glissante en heures
  antiFractioningMaxAmount   Float  @default(100000.0) // Seuil maximum de retraits cumulés sans alerte
  antiFractioningMaxCount    Int    @default(3) // Nombre d'opérations maximum sur la fenêtre
  antiFractioningAction      String @default("APPLY_FEE") // ALLOW, APPLY_FEE, BLOCK, ALERT

  // Treasury & Liquidity Policies (V6)
  maxMintAmount               Float @default(1000000000.0) // Max 1 Milliard par requête Mint
  treasuryApprovalThreshold   Float @default(5000000.0) // Au-delà, requiert SUPER_ADMIN spécifiquement
  agencyLowLiquidityThreshold Float @default(15000000.0) // Alerte orange
  agencyCriticalLiquidity     Float @default(5000000.0) // Alerte rouge

  // Restriction réseau du portail personnel (équivalent applicatif d'un VPN pour la jambe
  // admin-web ↔ backend) — désactivée par défaut : le personnel travaille depuis des réseaux
  // variables (télétravail, terrain), une liste vide + activée bloquerait tout le monde.
  // Voir middleware/adminIpAllowlist.ts pour l'application et les gardes anti-auto-verrouillage
  // (l'approbation Maker/Checker refuse d'activer si la liste résultante exclurait l'IP du
  // Checker qui approuve, ou si elle est vide).
  adminIpAllowlistEnabled Boolean  @default(false)
  adminIpAllowlist        String[] @default([])

  // Pénalité de retard tontine (voir tontineService.ts, executeTontineCycle) — pourcentage
  // de group.contribution prélevé, en plus de la cotisation, à quiconque n'a pas complété
  // son versement à l'échéance du cycle. Désactivée par défaut (0) : une plateforme ne doit
  // jamais se mettre à prélever une pénalité que ses utilisateurs n'ont jamais acceptée sans
  // qu'un opérateur l'active explicitement.
  tontineLatePenaltyRate Float @default(0)

  updatedAt DateTime @updatedAt
}

model SettingHistory {
  id        String @id @default(uuid())
  category  String // FEES, LIMITS, SECURITY, MAINTENANCE...
  parameter String // La clé (ex: taxP2P)
  oldValue  String
  newValue  String

  authorId String
  author   Staff  @relation("HistoryMaker", fields: [authorId], references: [id])

  checkerId String?
  checker   Staff?  @relation("HistoryChecker", fields: [checkerId], references: [id])

  reason String
  status String @default("APPLIED") // APPLIED, REJECTED

  createdAt DateTime @default(now())
}

model SettingsApproval {
  id              String   @id @default(uuid())
  makerId         String
  checkerId       String?
  action          String // Ex: UPDATE_FEES, TOGGLE_MAINTENANCE
  payload         String
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  maker   Staff  @relation("MakerRequests", fields: [makerId], references: [id])
  checker Staff? @relation("CheckerRequests", fields: [checkerId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("INFO") // INFO, TRANSACTION, SECURITY, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TontineGroup {
  id              String    @id @default(uuid())
  creatorId       String
  creator         User      @relation("GroupCreator", fields: [creatorId], references: [id])
  name            String
  contribution    Float
  frequency       String    @default("MONTHLY") // WEEKLY, MONTHLY
  startDate       DateTime  @default(now())
  status          String    @default("ACTIVE") // ACTIVE, PENDING_RENEWAL, COMPLETED, CANCELLED
  currentCycle    Int       @default(1)
  lastPayoutDate  DateTime? // Date du dernier paiement, pour rattrapage CRON si crash
  // Sondage de relance en fin de boucle (status PENDING_RENEWAL) : chaque participant vote
  // via TontineParticipant.renewalVote avant cette date. Passé ce délai (ou dès que tout le
  // monde a répondu), resolveRenewalPoll (tontineService.ts) tranche — voir son commentaire.
  renewalDeadline DateTime?
  // Mise en pause admin (litige, enquête) : le CRON saute executeTontineCycle tant que
  // isPaused=true, sans altérer currentCycle/lastPayoutDate — la tontine reprend exactement
  // où elle en était à la levée de la pause.
  isPaused        Boolean   @default(false)
  pausedReason    String?
  // Rejoignable librement via /tontine/discover + POST /tontine/join si true — sinon
  // (par défaut, et pour tous les groupes créés avant ce champ) invitation uniquement.
  // /tontine/join ne vérifiait auparavant AUCUNE condition de visibilité : n'importe
  // quel utilisateur authentifié connaissant un groupId pouvait rejoindre n'importe
  // quelle tontine, y compris une tontine que son créateur pensait invitation-only.
  isPublic        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants TontineParticipant[]
  cycles       TontineCycle[]
}

model TontineParticipant {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  tontineGroupId    String
  group             TontineGroup @relation(fields: [tontineGroupId], references: [id])
  status            String       @default("ACTIVE") // ACTIVE, PAUSED, LEFT
  joinedAt          DateTime     @default(now())
  payoutOrder       Int          @default(0)
  // Empêche un participant (typiquement le créateur, seul habilité à réordonner via
  // POST /tontine/reorder) de se réattribuer indéfiniment la cagnotte en réassignant son
  // propre payoutOrder au cycle courant avant chaque exécution — voir tontineService.ts,
  // executeTontineCycle : un participant déjà payé n'est plus jamais sélectionné comme
  // bénéficiaire, quelle que soit la valeur de payoutOrder au moment du cycle.
  hasReceivedPayout Boolean      @default(false)
  // Réponse au sondage de relance (group.status PENDING_RENEWAL) : null (pas encore
  // répondu), 'YES', 'NO'. Remis à null par resolveRenewalPoll au démarrage de chaque
  // nouvelle boucle — un vote ne vaut que pour la boucle qui vient de se terminer.
  renewalVote       String?

  contributions TontineContribution[]
}

// Grand livre structuré des cycles de tontine — avant, seules des Transaction avec une
// reference conventionnelle (TONT_DBT_G{id}_C{cycle}_U{userId}) permettaient de reconstituer
// l'historique, en parsant des chaînes plutôt qu'en interrogeant des relations. Un cycle
// avance toujours (voir tontineService.ts), même sans bénéficiaire trouvé ou cagnotte vide —
// status distingue donc "tout le monde a payé" de "au moins un échec".
model TontineCycle {
  id                       String       @id @default(uuid())
  tontineGroupId           String
  tontineGroup             TontineGroup @relation(fields: [tontineGroupId], references: [id], onDelete: Cascade)
  cycleNumber              Int
  status                   String       @default("COMPLETED") // COMPLETED, PARTIAL (au moins une cotisation en échec)
  beneficiaryParticipantId String?
  payoutTransactionId      String?
  totalExpected            Float
  totalCollected           Float
  executedAt               DateTime     @default(now())

  contributions TontineContribution[]

  @@unique([tontineGroupId, cycleNumber])
}

model TontineContribution {
  id            String             @id @default(uuid())
  cycleId       String
  cycle         TontineCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  participantId String
  participant   TontineParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  transactionId String?
  // Montant CUMULÉ versé pour ce cycle — pas un dépôt figé unique. Un participant peut
  // cotiser en plusieurs fois, d'un montant libre à chaque fois (voir tontineService.ts,
  // collectParticipantContribution) ; `amount` grandit à chaque dépôt jusqu'à atteindre
  // TontineGroup.contribution.
  amount        Float
  status        String             @default("PAID") // PAID (amount >= contribution), PARTIAL (0 < amount < contribution), FAILED (legacy — cycles antérieurs au dépôt libre, 0 collecté)
  createdAt     DateTime           @default(now())

  // Pénalité de retard (voir SystemSettings.tontineLatePenaltyRate) — appliquée UNE SEULE
  // FOIS par cycle manqué, au moment de l'échéance (executeTontineCycle), jamais lors d'un
  // rattrapage ultérieur (contributeNow/retryFailedContributions) : `penaltyAppliedAt` sert
  // de garde contre une double pénalité si l'admin relance la collecte plusieurs fois pour
  // le même cycle. `penaltyAmount` reste à 0 tant qu'aucune pénalité n'a pu être prélevée
  // (taux à 0, ou solde insuffisant au moment de la tentative).
  penaltyAmount    Float     @default(0)
  penaltyAppliedAt DateTime?

  @@unique([cycleId, participantId])
  @@index([participantId])
}

// ==========================================
// MONGAAIN V6: CORE BANKING ERP DOMAIN
// ==========================================

model Branch {
  id      String  @id @default(uuid())
  code    String  @unique @default(uuid()) // Ex: MNG-LBV-001
  name    String  @unique
  address String?
  city    String?
  region  String? // Ex: Estuaire, Ogooué-Maritime
  phone   String? // Téléphone de l'agence
  status  String  @default("DRAFT") // DRAFT, CONFIGURED, ACTIVE, SUSPENDED, CLOSED

  balance     Float     @default(0.0) // Physical Cash Float (Coffre)
  isActive    Boolean   @default(true) // Legacy fallback
  isHQ        Boolean   @default(false)
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  walletId String? @unique // Electronic Wallet for Caisse Électronique
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  managerId String? @unique
  manager   Staff?  @relation("BranchManager", fields: [managerId], references: [id])

  staff                  Staff[]              @relation("BranchStaff")
  sessions               CashSession[]
  targetTreasuryRequests TreasuryRequest[]
  reconciliationCases    ReconciliationCase[]
}

model CashSession {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  tellerId String
  teller   Staff  @relation("TellerSessions", fields: [tellerId], references: [id])

  status   String    @default("OPEN") // OPEN, CLOSED
  openedAt DateTime  @default(now())
  closedAt DateTime?

  initialCash Float  @default(0.0)
  finalCash   Float?

  totalCashInValue  Float @default(0.0)
  totalCashOutValue Float @default(0.0)

  discrepancy       Float?
  discrepancyReason String?
}

model TreasuryRequest {
  id          String  @id @default(uuid())
  reference   String  @unique // ex: TR-20260816-0001
  type        String // ISSUANCE, ALLOCATION, RETURN
  amount      Float
  currency    String  @default("FCFA")
  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED, EXECUTED
  reason      String
  comment     String?
  documentUrl String?

  makerId String
  maker   Staff  @relation("TreasuryMaker", fields: [makerId], references: [id])

  checkerId       String?
  checker         Staff?  @relation("TreasuryChecker", fields: [checkerId], references: [id])
  rejectionReason String?

  targetBranchId String?
  targetBranch   Branch? @relation(fields: [targetBranchId], references: [id])

  targetWalletId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  executedAt DateTime?
}

model ReconciliationCase {
  id        String @id @default(uuid())
  reference String @unique // ex: REC-20260816-001

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  expectedAmount Float
  reportedAmount Float
  difference     Float

  status        String  @default("UNDER_REVIEW") // MATCHED, MISMATCH, UNDER_REVIEW, RESOLVED
  investigation String?
  resolution    String?

  managerId String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Staff {
  id       String @id @default(uuid())
  email    String @unique // Auth identifier for Web Portal
  password String // bcrypt hash (complex enterprise pwd)
  name     String
  role     String // SUPER_ADMIN, RISK, COMPLIANCE_CHECKER, SUPPORT_MAKER, BRANCH_MANAGER, TELLER

  // RBAC: liste granulaire des permissions accordées à cet employé.
  // Si null → les droits sont hérités du rôle par défaut (voir RBAC.ts).
  // Si renseigné → les droits du rôle sont ignorés, on utilise cette liste personnalisée.
  permissions           Json? // string[] — ex: ["perm_customer_kyc_view", "perm_cash_session_open"]
  permissionsCustomized Boolean @default(false) // true si un SUPER_ADMIN a configuré des droits personnalisés

  // Bank-Grade Corporate Identity
  matricule      String? @unique
  cni            String?
  phone          String?
  address        String?
  dob            String?
  gender         String?
  emergencyPhone String?

  status             String  @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED
  createdById        String? // Maker (recruteur) — interdit l'auto-approbation à l'onboarding
  mustChangePassword Boolean @default(false) // Forcé à true pour tout nouveau compte créé via l'onboarding

  isActive Boolean @default(true) // Legacy fallback

  // Anti-brute-force sur /api/corp/login (aucune protection n'existait avant — un mot de
  // passe staff était devinable sans limite) + révocation de session : incrémenté à chaque
  // changement de mot de passe ou suspension pour invalider immédiatement tout token déjà émis.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  jwtVersion          Int       @default(0)

  branchId String?
  branch   Branch? @relation("BranchStaff", fields: [branchId], references: [id])

  managedBranch Branch?       @relation("BranchManager")
  cashSessions  CashSession[] @relation("TellerSessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  makerRequests            SettingsApproval[]      @relation("MakerRequests")
  checkerRequests          SettingsApproval[]      @relation("CheckerRequests")
  reclamationsAssigned     Reclamation[]           @relation("ReclamationAssignee")
  treasuryMakerRequests    TreasuryRequest[]       @relation("TreasuryMaker")
  treasuryCheckerRequests  TreasuryRequest[]       @relation("TreasuryChecker")
  settingHistoryMade       SettingHistory[]        @relation("HistoryMaker")
  settingHistoryChecked    SettingHistory[]        @relation("HistoryChecker")
  riskFlagsReported        RiskFlag[]              @relation("RiskAuthor")
  fraudCasesAnalyzed       FraudCase[]             @relation("FraudAnalyst")
  refundRequestsMade       RefundRequest[]         @relation("RefundRequester")
  refundRequestsApproved   RefundRequest[]         @relation("RefundApprover")
  merchantPayoutsProcessed MerchantPayoutRequest[] @relation("MerchantPayoutProcessor")
  verificationCode         StaffVerificationCode?
}

// 2FA personnel (portail admin-web) : le compte client a déjà PIN + OTP SMS (deux facteurs),
// mais /api/corp/login se limitait à un mot de passe — un écart pour un portail qui donne
// accès aux documents KYC, à l'émission de monnaie, etc. Modèle séparé de VerificationCode
// (client) plutôt que réutilisé : ce dernier est indexé par téléphone (identifiant client),
// alors que le personnel s'identifie par email et n'a pas toujours de téléphone renseigné
// (Staff.phone est optionnel) — un seul but ici (LOGIN), pas besoin du champ `purpose`.
model StaffVerificationCode {
  id        String   @id @default(uuid())
  staffId   String   @unique
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==========================================
// MONGAAIN V6: RISK & FRAUD MANAGEMENT (PROMPT 08)
// ==========================================

// ==========================================
// MONGAAIN V6: SUPPORT, LITIGES & REFUNDS (PROMPT 09)
// ==========================================

model FraudCase {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  analystId String?
  analyst   Staff?  @relation("FraudAnalyst", fields: [analystId], references: [id])

  type        String  @default("SUSPICIOUS_ACTIVITY") // SUSPICIOUS_ACTIVITY, ACCOUNT_TAKEOVER, MONEY_LAUNDERING, IDENTITY_THEFT
  riskLevel   String  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String  @default("OPEN") // OPEN, INVESTIGATION, CONFIRMED, FALSE_POSITIVE, CLOSED
  description String
  decision    String? // VALID, INVALID, FRAUD, TECHNICAL_ERROR

  linkedTransactionIds String  @default("[]")
  reclamationId        String?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RefundRequest {
  id            String  @id @default(uuid())
  transactionId String  @unique // Contrainte anti-double-refund atomique
  userId        String
  user          User    @relation(fields: [userId], references: [id])
  requesterId   String
  requester     Staff   @relation("RefundRequester", fields: [requesterId], references: [id])
  approverId    String?
  approver      Staff?  @relation("RefundApprover", fields: [approverId], references: [id])

  amount        Float
  refundType    String       @default("FULL") // FULL, PARTIAL
  reason        String
  description   String
  reclamationId String?
  reclamation   Reclamation? @relation(fields: [reclamationId], references: [id])

  status          String    @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, EXECUTED, REJECTED
  rejectionReason String?
  executedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskFlag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  type   String @default("SUSPICIOUS_ACTIVITY") // SUSPICIOUS_ACTIVITY, AML_ALERT, FRAUD_REPORT, IDENTITY_THEFT, ANTI_FRACTIONING
  status String @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED

  authorId String
  author   Staff  @relation("RiskAuthor", fields: [authorId], references: [id])

  description String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// ==========================================
// MONGAIN V6: API MANAGEMENT (FINAL AUDIT)
// ==========================================

model ApiIntegration {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    User     @relation("MerchantAPI", fields: [merchantId], references: [id])
  appName     String
  environment String   @default("TEST") // TEST, LIVE
  publicKey   String   @unique @default(uuid()) // Displayed freely
  secretHash  String // bcrypt hash — NEVER returned in API responses
  webhookUrl  String?
  isActive    Boolean  @default(true)
  permissions String   @default("PAYMENTS") // Comma-separated: PAYMENTS, REFUNDS, REPORTS
  description String?
  rotatedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs ApiLog[]

  @@index([merchantId])
}

model ApiLog {
  id            String         @id @default(uuid())
  integrationId String
  integration   ApiIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  action        String // GENERATE, ROTATE, ACTIVATE, DEACTIVATE, ENV_CHANGE
  actorId       String // Staff ID who performed the action
  ipAddress     String?
  createdAt     DateTime       @default(now())
}

// Journal technique des erreurs backend (intégrations externes, exceptions non gérées) —
// pour que l'équipe voie les échecs réels depuis l'admin-web au lieu de devoir fouiller les
// logs Render à chaque fois qu'un test échoue. Distinct des Reclamation (signalements client).
model ErrorLog {
  id        String   @id @default(uuid())
  source    String // ex: PVIT_PAYMENT, PVIT_WEBHOOK, UNCAUGHT
  message   String
  details   String? // contexte brut (corps de réponse, stack, paramètres) — jamais de secrets
  path      String?
  userId    String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([source])
  @@index([resolved])
  @@index([createdAt])
}

// ==========================================
// MONGAIN V6: CAISSE COMMUNE (MULTISIG VAULT)
// ==========================================

model Vault {
  id                String   @id @default(uuid())
  name              String
  description       String?
  balance           Float    @default(0.0)
  // Nombre d'approbations de commissaires requises pour exécuter un retrait.
  // Démarre à 1 (le créateur peut agir seul) plutôt qu'une constante codée en
  // dur à 2 — l'ancienne logique bloquait indéfiniment toute caisse n'ayant
  // qu'un seul validateur désigné, le cas le plus fréquent à la création.
  requiredApprovals Int      @default(1)
  createdAt         DateTime @default(now())

  // Gel admin (litige, enquête) : bloque deposit/withdraw-request/approve/voucher-spend
  // côté vault.ts tant que isFrozen=true, sans toucher au solde ni aux membres.
  isFrozen     Boolean   @default(false)
  frozenReason String?
  frozenAt     DateTime?

  adminId String
  admin   User   @relation("AdminVault", fields: [adminId], references: [id])

  members      VaultMember[]
  transactions VaultTransaction[]
  vouchers     VaultVoucher[]
}

model VaultMember {
  id      String @id @default(uuid())
  vaultId String
  userId  String

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  user  User  @relation("VaultMembership", fields: [userId], references: [id])

  // Roles
  isAdmin             Boolean @default(false)
  isInitiator         Boolean @default(false) // Responsable
  isValidator         Boolean @default(false) // Peut approuver
  isTreasurer         Boolean @default(false) // Trésorier désigné
  // Son approbation est obligatoire pour TOUT retrait, en plus du seuil numérique
  // Vault.requiredApprovals — répond au besoin de désigner des personnes précises (pas
  // juste "N validateurs au hasard parmi le pool"). Toujours false si isValidator=false
  // (voir PUT /:id/roles, qui force la cohérence).
  isRequiredValidator Boolean @default(false)

  joinedAt DateTime @default(now())

  @@unique([vaultId, userId])
}

model VaultTransaction {
  id      String @id @default(uuid())
  vaultId String
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  type   String // DEPOSIT, WITHDRAW_REQUEST
  amount Float
  status String @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED

  destinationType String? // TREASURER, VOUCHER (Physical Agency/Merchant), TRANSFER (envoi direct)
  destinationId   String? // The User ID of the Treasurer, President, or destinataire TRANSFER
  // Motif obligatoire sur une demande de retrait — donne aux commissaires de quoi
  // juger la légitimité d'une sortie de fonds avant d'approuver, notamment pour un
  // envoi direct vers un tiers qui n'est pas membre de la caisse.
  reason          String?

  requestedById String
  requestedBy   User   @relation("RequestedVaultTransactions", fields: [requestedById], references: [id])

  createdAt DateTime @default(now())

  // Seuil et liste des commissaires obligatoires figés au moment de la CRÉATION de la
  // demande (routes/vault.ts, POST /:id/withdraw-request), plutôt que recalculés à chaque
  // approbation depuis les VaultMember courants. Sans ce gel, un initiateur malveillant
  // pouvait faire partir des commissaires (dont un validateur obligatoire) APRÈS avoir fait
  // approuver sa propre demande par un complice, pour faire mécaniquement chuter le seuil
  // effectif (min(seuil configuré, nb de commissaires restants)) et faire disparaître
  // l'obligation du validateur parti — voir POST /:id/approve/:txId.
  requiredApprovalsSnapshot    Int?
  requiredValidatorIdsSnapshot String[] @default([])

  approvals VaultApproval[]
}

model VaultApproval {
  id            String           @id @default(uuid())
  transactionId String
  transaction   VaultTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ApprovedVaultTransactions", fields: [userId], references: [id])

  approvedAt DateTime @default(now())

  @@unique([transactionId, userId])
}

model VaultVoucher {
  id      String @id @default(uuid())
  vaultId String
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  amount     Float
  status     String  @default("ACTIVE") // ACTIVE, USED, VOID (annulé par un admin — litige/erreur)
  voidReason String?

  presidentId String
  president   User   @relation("VaultVouchers", fields: [presidentId], references: [id])

  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model VirtualCard {
  id              String @id @default(uuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id])
  fundingWalletId String
  fundingWallet   Wallet @relation("FundingWalletVirtualCards", fields: [fundingWalletId], references: [id])
  cardNumber      String @unique
  cvv             String
  expiryDate      String
  status          String @default("ACTIVE")
  spendingLimit   Float  @default(0)
  balance         Float  @default(0)
}

model CryptoWallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  asset     String // "BTC", "ETH", "USDT"
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CryptoTransaction {
  id           String   @id @default(uuid())
  userId       String
  type         String // "BUY", "SELL"
  asset        String // e.g "BTC"
  amountCrypto Float
  amountFiat   Float // XAF equivalent
  exchangeRate Float
  fee          Float
  createdAt    DateTime @default(now())
}

model SplitRequest {
  id          String   @id @default(uuid())
  amount      Float
  requesterId String
  requester   User     @relation("SplitRequester", fields: [requesterId], references: [id])
  targetPhone String
  targetId    String?
  target      User?    @relation("SplitTarget", fields: [targetId], references: [id])
  status      String   @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt   DateTime @default(now())
}

model Loan {
  id           String   @id @default(uuid())
  userId       String
  amount       Float
  interestRate Float    @default(0.05)
  totalOwed    Float
  status       String   @default("ACTIVE") // ACTIVE, PAID, DEFAULTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ==========================================
// V15: MONGAIN PRO (B2B, INVOICING, PAYROLL)
// ==========================================

model Invoice {
  id            String    @id @default(uuid())
  merchantId    String
  customerPhone String
  amount        Float
  description   String?
  status        String    @default("PENDING") // PENDING, PAID, CANCELLED
  transactionId String? // reference to Ledger transaction when paid
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  updatedAt     DateTime  @updatedAt

  merchant User @relation("MerchantInvoices", fields: [merchantId], references: [id])
}

model PayoutBulk {
  id          String    @id @default(uuid())
  merchantId  String
  name        String?
  totalAmount Float     @default(0)
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  merchant User          @relation("MerchantPayoutBulks", fields: [merchantId], references: [id])
  entries  PayoutEntry[]
}

model PayoutEntry {
  id            String  @id @default(uuid())
  bulkId        String
  phone         String
  amount        Float
  status        String  @default("PENDING") // PENDING, SUCCESS, FAILED
  errorReason   String?
  transactionId String?

  bulk PayoutBulk @relation(fields: [bulkId], references: [id], onDelete: Cascade)
}

// ==========================================
// V16: MARKETPLACE & ESCROW
// ==========================================

model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation("UserListings", fields: [sellerId], references: [id])
  title       String
  description String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  escrows EscrowTransaction[]
}

model EscrowTransaction {
  id         String        @id @default(cuid())
  buyerId    String
  buyer      User          @relation("BuyerEscrows", fields: [buyerId], references: [id])
  sellerId   String
  seller     User          @relation("SellerEscrows", fields: [sellerId], references: [id])
  listingId  String
  listing    MarketListing @relation(fields: [listingId], references: [id])
  amount     Float
  status     String // "LOCKED", "RELEASED", "DISPUTED", "REFUNDED"
  createdAt  DateTime      @default(now())
  releasedAt DateTime?
}

// ==========================================
// V16: WEALTH MANAGEMENT & STAKING
// ==========================================

model StakingVault {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserStaking", fields: [userId], references: [id])
  amount      Float
  apy         Float
  lockedUntil DateTime
  status      String // "ACTIVE", "MATURED", "WITHDRAWN"
  createdAt   DateTime @default(now())
}

// ==========================================
// V16: OAUTH / MONGAIN CONNECT
// ==========================================

model ApiKey {
  id         String   @id @default(cuid())
  merchantId String
  merchant   User     @relation("MerchantApiKeys", fields: [merchantId], references: [id])
  keyHash    String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}
