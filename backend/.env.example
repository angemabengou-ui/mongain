DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/mongain_db?schema=public"
JWT_SECRET="votre_clef_secrete_ultra_longue_ici" # Obligatoire si NODE_ENV=production
PORT=3000
NODE_ENV=development

# CORS : domaines additionnels autorisés en production (séparés par des virgules)
ALLOWED_ORIGINS=""

# Rechargement carte bancaire : désactivé tant qu'aucune passerelle de paiement
# réelle n'est intégrée (voir backend/src/routes/wallet.ts, route /topup).
ENABLE_UNVERIFIED_CARD_TOPUP=false

# Paiement de factures / recharge de crédit téléphonique (SEEG, Canal+, Airtel/Moov airtime) :
# désactivé tant qu'aucune passerelle réelle n'est intégrée (voir backend/src/routes/services.ts).
ENABLE_UNVERIFIED_EXTERNAL_SERVICES=false

# Achat/vente de cryptomonnaies (voir backend/src/routes/crypto.ts) : le taux de change et le
# "marché en direct" sont actuellement simulés (RATES codé en dur + variation aléatoire), sans
# bourse, custodian ni blockchain connectée. Débiter un client réel sur cette base serait
# trompeur — désactivé tant qu'un partenaire réel (exchange/custodian) n'est pas intégré.
ENABLE_UNVERIFIED_CRYPTO=false

# Cartes virtuelles (voir backend/src/routes/cards.ts) : numéro/CVV générés localement, aucun
# réseau Visa/Mastercard ni processeur de cartes connecté — une carte émise ne fonctionnerait
# chez aucun marchand réel. Désactivé tant qu'un émetteur de cartes réel n'est pas intégré.
ENABLE_UNVERIFIED_CARDS=false

# Remise internationale (voir backend/src/routes/remit.ts) : taux de change simulés (FX_RATES
# codé en dur "Mock Rates for MVP"), aucun partenaire de transfert/paiement à l'étranger — les
# fonds débités au client ne partent jamais réellement vers la destination annoncée. Désactivé
# tant qu'un partenaire de transfert réel n'est pas intégré (voir aussi les contraintes BEAC/
# CEMAC sur les transferts internationaux par un acteur non-bancaire).
ENABLE_UNVERIFIED_REMIT=false

# PVit (agrégateur de paiement Mobile Money/carte, mypvit.pro) — Dépôt Mobile Money
# (POST /api/wallet/pull) : PAS de variable d'environnement ici. Ces identifiants se
# configurent depuis l'admin-web (Paramètres > Passerelles de Paiement), stockés dans
# SystemSettings — voir backend/src/services/pvit.ts.

# Scripts de seed (activate-admin.ts, seed-staff.ts) : si absent, un mot de passe
# aléatoire est généré et affiché une seule fois dans la console.
SEED_ADMIN_PASSWORD=""

# SMS Configuration
SMS_ENABLED=false
TWILIO_ACCOUNT_SID="ACxxx..."
TWILIO_AUTH_TOKEN="votre_token_twilio..."
TWILIO_PHONE_NUMBER="+1234567890"
